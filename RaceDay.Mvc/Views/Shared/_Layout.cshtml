<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    <!-- ═══════════════ NAVBAR ═══════════════ -->
    <nav class="navbar navbar-expand-lg navbar-dark raced-nav">
        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                🏁 RACEDAY
            </a>

            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="nav">

                <!-- Menu esquerdo (links por role) -->
                <ul class="navbar-nav me-auto">

                    @if (Context.Session.GetString("Role") == "Organiser")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a>
                        </li>
                    }
                    else if (Context.Session.GetString("Role") == "Participant")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a>
                        </li>
                    }

                </ul>

                <!-- Lado direito (login/logout) -->
                <div class="d-flex align-items-center gap-3 text-white">

                    @if (Context.Session.GetString("Token") != null)
                    {
                        <span class="small">@Context.Session.GetString("Name")</span>

                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-outline-light btn-sm">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                        <a class="btn btn-warning btn-sm fw-semibold"
                           asp-controller="Account"
                           asp-action="Register">
                            Join now
                        </a>
                    }

                </div>

            </div>
        </div>
    </nav>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <main class="container py-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        @RenderBody()

    </main>

    <!-- ═══════════════ FOOTER ═══════════════ -->
    <footer class="mt-5 py-4 text-center text-secondary">
        RaceDay · Every finish line starts with a decision.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>