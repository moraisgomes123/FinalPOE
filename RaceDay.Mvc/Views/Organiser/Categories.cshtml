@{
    ViewData["Title"] = "Categories";
    var cats = ViewBag.Categories as List<ApiCategory> ?? new();
}

<h1 class="page-heading mb-4">Event categories</h1>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-4">
            <h5>Add a category</h5>

            <form asp-action="AddCategory" asp-route-id="@ViewBag.EventId" method="post">
                <div class="mb-3">
                    <label class="form-label">Category name</label>
                    <input name="CategoryName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Distance (km)</label>
                    <input name="DistanceKm" type="number" step="0.01" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Maximum participants</label>
                    <input name="MaximumParticipants" type="number" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Entry fee</label>
                    <input name="EntryFee" type="number" step="0.01" value="0" class="form-control" />
                </div>

                <button class="btn btn-dark">Add category</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-4">
            <h5>Available categories</h5>

            @foreach (var c in cats)
            {
                <div class="border-bottom py-3">
                    <strong>@c.CategoryName</strong>
                    <span class="text-secondary"> · @c.DistanceKm km · R @c.EntryFee</span>
                </div>
            }
        </div>
    </div>
</div>