@model RaceDay.Mvc.Models.OrganiserEnrolmentsViewModel

@{
    ViewData["Title"] = "Enrolments";
}

<h1 class="page-heading">
    Enrolments · @Model.EventName
</h1>

<div class="card p-4 mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Registered Participants</h4>

        <span class="badge bg-primary">
            @Model.Enrolments.Count Participants
        </span>
    </div>

    @if (!Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Enrolments)
                    {
                        <tr>
                            <td>@item.EnrolmentID</td>

                            <td>@item.ParticipantName</td>

                            <td>@item.CategoryName</td>

                            <td>
                                @item.EnrolmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-action="Events"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>

</div>