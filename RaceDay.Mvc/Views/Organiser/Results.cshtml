@model RaceDay.Mvc.Models.OrganiserResultsViewModel

@{
    ViewData["Title"] = "Results";
}

<h1 class="page-heading">
    Results · @Model.EventName
</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card p-4 mt-4">

    <h4 class="mb-3">Record Participant Results</h4>

    @if (!Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            There are no participants enrolled in this event.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment ID</th>
                        <th>Result</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var enrolment in Model.Enrolments)
                    {
                        var existingResult = Model.Results
                            .FirstOrDefault(r =>
                                r.EnrolmentID == enrolment.EnrolmentID);

                        <tr>
                            <td>@enrolment.ParticipantName</td>

                            <td>@enrolment.CategoryName</td>

                            <td>@enrolment.EnrolmentID</td>

                            <td>
                                @if (existingResult != null)
                                {
                                    <span class="badge bg-success">
                                        @existingResult.ResultStatus
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="AddResult"
                                          method="post"
                                          class="d-flex flex-column gap-2">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="EventID"
                                               value="@Model.EventID" />

                                        <input type="hidden"
                                               name="EnrolmentID"
                                               value="@enrolment.EnrolmentID" />

                                        <input type="number"
                                               name="FinishPosition"
                                               class="form-control"
                                               placeholder="Position"
                                               min="1" />

                                        <input type="time"
                                               name="FinishTime"
                                               class="form-control"
                                               step="1" />

                                        <select name="ResultStatus"
                                                class="form-select">

                                            <option value="Finished">
                                                Finished
                                            </option>

                                            <option value="DNF">
                                                DNF
                                            </option>

                                            <option value="DNS">
                                                DNS
                                            </option>

                                            <option value="Disqualified">
                                                Disqualified
                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Save Result
                                        </button>

                                    </form>
                                }
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

<div class="card p-4 mt-4">

    <h4 class="mb-3">Published Results</h4>

    @if (!Model.Results.Any())
    {
        <p class="text-secondary">
            No results have been recorded yet.
        </p>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var result in Model.Results
                        .OrderBy(r => r.FinishPosition ?? int.MaxValue))
                    {
                        <tr>
                            <td>@result.ParticipantName</td>

                            <td>
                                @(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "-")
                            </td>

                            <td>
                                @(result.FinishPosition?.ToString() ?? "-")
                            </td>

                            <td>@result.ResultStatus</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

<a asp-action="Events"
   class="btn btn-outline-secondary mt-3">
    Back to Events
</a>