@model List<ApiEvent>
@{
    ViewData["Title"] = "Organiser dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="eyebrow">Organiser workspace</div>
        <h1 class="page-heading">Dashboard</h1>
        <p class="text-secondary">A quick overview of your race programme.</p>
    </div>
    <a class="btn btn-warning fw-bold" asp-action="CreateEvent">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-4">
            <div class="text-secondary">Your events</div>
            <div class="stat">@ViewBag.Total</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4">
            <div class="text-secondary">Upcoming events</div>
            <div class="stat">@ViewBag.Upcoming</div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h5 class="fw-bold">Your event schedule</h5>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Location</td>
                        <td>@e.EventType</td>
                        <td>
                            <a asp-action="Categories" asp-route-id="@e.EventID">Categories</a> ·
                            <a asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a> ·
                            <a asp-action="Results" asp-route-id="@e.EventID">Results</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>