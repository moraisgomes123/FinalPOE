@model List<ApiEvent>
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between mb-4">
    <h1 class="page-heading">Event management</h1>
    <a class="btn btn-warning" asp-action="CreateEvent">+ Create event</a>
</div>

<div class="card p-3">
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Location</td>
                    <td>
                        <a asp-action="Categories" asp-route-id="@e.EventID">Manage categories</a> ·
                        <a asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a> ·
                        <a asp-action="Results" asp-route-id="@e.EventID">Results</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>