@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4 p-md-5">
            <div class="eyebrow">Welcome back</div>
            <h1 class="page-heading mb-3">Sign in to RaceDay</h1>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control mb-3" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control mb-3" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <button class="btn btn-dark btn-lg w-100">Login</button>
            </form>

            <p class="mt-3 mb-0">
                New to RaceDay? <a asp-action="Register">Create an account</a>
            </p>
        </div>
    </div>
</div>
